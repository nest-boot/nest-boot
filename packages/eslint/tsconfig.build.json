{
  "extends": "@nest-boot/tsconfig/library.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": "./src"
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.spec.ts",
    "node_modules",
    "test",
    "dist",
    "**/*.spec.ts",
    "**/*.e2e-spec.ts"
  ]
}
