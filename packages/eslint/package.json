{
  "name": "@nest-boot/eslint",
  "version": "8.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nest-boot/nest-boot.git",
    "directory": "packages/eslint"
  },
  "description": "Shared ESLint flat configurations and custom rules for Nest Boot",
  "author": {
    "name": "Xudong Huang",
    "email": "me@huangxudong.com",
    "url": "https://www.huangxudong.com/"
  },
  "homepage": "",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "directories": {
    "lib": "dist"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./library": {
      "types": "./dist/library.d.ts",
      "import": "./dist/library.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "pnpm run clean",
    "build": "tsc -p tsconfig.build.json",
    "clean": "tsc -b --clean tsconfig.build.json && rm -rf dist",
    "dev": "tsc -p tsconfig.build.json --watch",
    "docs:update": "pnpm run build && eslint-doc-generator",
    "docs:check": "eslint-doc-generator --check",
    "lint": "eslint \"{src,test}/**/*.ts\" && eslint-doc-generator --check",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "test:debug": "vitest --inspect-brk --no-file-parallelism"
  },
  "dependencies": {
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/parser": "^8.74.0",
    "@typescript-eslint/utils": "^8.74.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "ts-api-utils": "^2.5.0",
    "typescript-eslint": "^8.74.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "typescript": "^6.0.0"
  },
  "devDependencies": {
    "@mikro-orm/core": "7.2.0",
    "@mikro-orm/decorators": "7.2.0",
    "@mikro-orm/postgresql": "7.2.0",
    "@mikro-orm/sql": "7.2.0",
    "@nest-boot/tsconfig": "workspace:^",
    "@types/node": "^24.0.0",
    "@typescript-eslint/rule-tester": "^8.74.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.3",
    "eslint-doc-generator": "^3.7.1",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "graphql-type-json": "0.3.2",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  }
}
