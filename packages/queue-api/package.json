{
  "name": "@nest-boot/queue-api",
  "version": "8.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nest-boot/nest-boot.git",
    "directory": "packages/queue-api"
  },
  "description": "Authenticated GraphQL queries and synchronized database records for Redis queues",
  "author": {
    "name": "Xudong Huang",
    "email": "me@huangxudong.com",
    "url": "https://www.huangxudong.com/"
  },
  "homepage": "",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "directories": {
    "lib": "dist"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "dev": "tsc -w -p tsconfig.build.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts --coverage",
    "test:watch": "vitest",
    "test:debug": "vitest --inspect-brk --no-file-parallelism"
  },
  "devDependencies": {
    "@mikro-orm/core": "7.2.0",
    "@mikro-orm/decorators": "7.2.0",
    "@mikro-orm/postgresql": "7.2.0",
    "@mikro-orm/sql": "7.2.0",
    "@nest-boot/database": "workspace:^",
    "@nest-boot/eslint-config": "workspace:^",
    "@nest-boot/eslint-plugin": "workspace:^",
    "@nest-boot/graphql": "workspace:^",
    "@nest-boot/graphql-connection": "workspace:^",
    "@nest-boot/request-context": "workspace:^",
    "@nest-boot/tsconfig": "workspace:^",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/testing": "^12.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "^4.1.11",
    "bullmq": "^6.3.12",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.3",
    "graphql": "^16.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.11",
    "pg": "^8.16.3",
    "zod": "^4.3.6",
    "@nest-boot/queue": "workspace:^",
    "@nest-boot/auth": "workspace:^",
    "@nest-boot/redis": "workspace:^",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.0.0",
    "supertest": "^7.0.0"
  },
  "peerDependencies": {
    "@mikro-orm/core": "^7.2.0",
    "@mikro-orm/decorators": "^7.2.0",
    "@mikro-orm/sql": "^7.2.0",
    "@nest-boot/database": "workspace:^",
    "@nest-boot/graphql": "workspace:^",
    "@nest-boot/graphql-connection": "workspace:^",
    "@nest-boot/request-context": "workspace:^",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/graphql": "^14.0.3",
    "bullmq": "^6.3.12",
    "graphql": "^16.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.0.0",
    "zod": "^4.0.0",
    "@nest-boot/queue": "workspace:^",
    "@nest-boot/auth": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "lodash-es": "^4.18.1"
  }
