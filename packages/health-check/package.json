{
  "name": "@nest-boot/health-check",
  "version": "8.0.2-beta.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/nest-boot/nest-boot.git",
    "directory": "packages/health-check"
  },
  "description": "Shared health indicator registration and Terminus health checks for Nest Boot",
  "author": {
    "name": "Xudong Huang",
    "email": "me@huangxudong.com",
    "url": "https://www.huangxudong.com/"
  },
  "homepage": "",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "directories": {
    "lib": "dist"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf .nx && rm -rf node_modules && rm -rf dist",
    "dev": "tsc -w -p tsconfig.build.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "pnpm build && vitest run",
    "test:cov": "pnpm build && vitest run --coverage",
    "test:watch": "pnpm build && vitest",
    "test:debug": "pnpm build && vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "pnpm build && vitest run --config ./vitest.config.e2e.ts --coverage"
  },
  "devDependencies": {
    "@nest-boot/eslint-config": "workspace:^",
    "@nest-boot/eslint-plugin": "workspace:^",
    "@nest-boot/middleware": "workspace:^",
    "@nest-boot/tsconfig": "workspace:^",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@nest-boot/middleware": "workspace:^",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/terminus": "^12.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "type": "module",
  "engines": {
    "node": ">=24.4.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
