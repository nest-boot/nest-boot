{
  "name": "@nest-boot/mastra",
  "version": "8.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nest-boot/nest-boot.git",
    "directory": "packages/mastra"
  },
  "description": "NestJS-native Mastra integration with DI auto-discovery, embedded Studio, auth protection, and PostgreSQL/ClickHouse storage",
  "author": {
    "name": "Xudong Huang",
    "email": "me@huangxudong.com",
    "url": "https://www.huangxudong.com/"
  },
  "homepage": "",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "directories": {
    "lib": "dist"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
    "prebuild": "pnpm run clean",
    "build": "tsc -p tsconfig.build.json",
    "clean": "tsc -b --clean tsconfig.build.json && rm -rf dist",
    "dev": "tsc -w -p tsconfig.build.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "test:debug": "vitest --inspect-brk --no-file-parallelism"
  },
  "dependencies": {
    "@mastra/clickhouse": "^1.30.1",
    "@mastra/deployer": "^1.85.0",
    "@mastra/nestjs": "^0.3.2",
    "@mastra/observability": "^1.24.2",
    "@mastra/pg": "^1.37.0",
    "lodash-es": "^4.18.1"
  },
  "peerDependencies": {
    "@mastra/core": "^1.84.0",
    "@nest-boot/auth": "workspace:^",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "express": "^5.0.0",
    "mastra": "^1.40.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "mastra": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mastra/core": "^1.84.0",
    "@nest-boot/auth": "workspace:^",
    "@nest-boot/eslint": "workspace:^",
    "@nest-boot/tsconfig": "workspace:^",
    "@nestjs/common": "^12.6.2",
    "@nestjs/core": "^12.6.2",
    "@nestjs/platform-express": "^12.6.2",
    "@nestjs/testing": "^12.6.2",
    "@types/express": "^5.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.3",
    "express": "^5.3.0",
    "mastra": "^1.40.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zod": "^4.3.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
