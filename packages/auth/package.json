{
  "name": "@nest-boot/auth",
  "version": "8.0.3-beta.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/nest-boot/nest-boot.git",
    "directory": "packages/auth"
  },
  "description": "Authentication, workspace identity, API keys, and CASL-based authorization for Nest Boot applications",
  "author": {
    "name": "Xudong Huang",
    "email": "me@huangxudong.com",
    "url": "https://www.huangxudong.com/"
  },
  "homepage": "",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "directories": {
    "lib": "dist"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "cookie": "^2.0.1",
    "graphql-type-json": "^0.3.2",
    "sonyflake-js": "^1.0.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf .nx && rm -rf node_modules && rm -rf dist",
    "dev": "tsc -w -p tsconfig.build.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "typecheck": "tsc --noEmit"
