  "devDependencies": {
    "@casl/ability": "^7.0.1",
    "@mikro-orm/core": "7.2.0",
    "@mikro-orm/decorators": "7.2.0",
    "@mikro-orm/pglite": "7.2.0",
    "@mikro-orm/sql": "7.2.0",
    "@nest-boot/eslint-config": "workspace:^",
    "@nest-boot/eslint-plugin": "workspace:^",
    "@nest-boot/graphql-connection": "workspace:^",
    "@nest-boot/hash": "workspace:^",
    "@nest-boot/mailer": "workspace:^",
    "@nest-boot/middleware": "workspace:^",
    "@nest-boot/request-context": "workspace:^",
    "@nest-boot/tsconfig": "workspace:^",
    "@nest-boot/validator": "workspace:^",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "better-auth": "^1.7.2",
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.11",
    "@nest-boot/graphql": "workspace:^",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/graphql": "^14.0.0",
    "graphql": "^16.11.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@casl/ability": "^7.0.0",
    "@mikro-orm/core": "^7.2.0",
    "@mikro-orm/decorators": "^7.2.0",
    "@mikro-orm/sql": "^7.2.0",
    "@nest-boot/graphql-connection": "workspace:^",
    "@nest-boot/hash": "workspace:^",
    "@nest-boot/mailer": "workspace:^",
    "@nest-boot/middleware": "workspace:^",
    "@nest-boot/request-context": "workspace:^",
    "@nest-boot/validator": "workspace:^",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "better-auth": "^1.7.2",
    "express": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.0.0",
    "@nest-boot/graphql": "workspace:^",
    "@nestjs/graphql": "^14.0.0",
    "graphql": "^16.0.0",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "typedocOptions": {
    "intentionallyNotExported": [
      "ApiKeyAuthenticationService",
      "LowercaseIdentifier"
    ]
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "type": "module",
  "engines": {
    "node": ">=24.4.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
