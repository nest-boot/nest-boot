{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "App Build",
  "extends": "./app.json",
  "compilerOptions": {
    "rootDir": "${configDir}/src",
    "outDir": "${configDir}/dist"
  },
  "include": ["${configDir}/src/**/*"],
  "exclude": [
    "${configDir}/node_modules",
    "${configDir}/dist",
    "${configDir}/test",
    "${configDir}/**/*.spec.ts",
    "${configDir}/**/*.spec-d.ts"
  ]
}
