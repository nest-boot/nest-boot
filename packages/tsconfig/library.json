{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Library",
  "extends": "./base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "removeComments": false,
    "rootDir": "${configDir}",
    "outDir": "${configDir}/dist"
  },
  "include": [
    "${configDir}/src",
    "${configDir}/test",
    "${configDir}/vitest.config.ts"
  ],
  "exclude": ["${configDir}/node_modules", "${configDir}/dist"]
}
