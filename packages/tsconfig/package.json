{
  "name": "@nest-boot/tsconfig",
  "version": "8.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nest-boot/nest-boot.git",
    "directory": "packages/tsconfig"
  },
  "license": "MIT",
  "files": [
    "app.json",
    "base.json",
    "library.json"
  ],
  "scripts": {
