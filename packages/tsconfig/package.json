    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "peerDependencies": {
    "typescript": "^6.0.0"
  },
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "exports": {
    "./app.json": "./app.json",
    "./base.json": "./base.json",
    "./library.json": "./library.json",
    "./package.json": "./package.json"
  }
}
