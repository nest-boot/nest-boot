{
  "name": "@nest-boot/tsconfig",
  "version": "8.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nest-boot/nest-boot.git",
    "directory": "packages/tsconfig"
  },
  "license": "MIT",
  "files": [
    "app.build.json",
    "app.json",
    "base.json",
    "library.build.json",
    "library.json"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "test:debug": "vitest --inspect-brk --no-file-parallelism"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0",
    "vitest": "^5.1.1"
  },
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "exports": {
    "./app.build.json": "./app.build.json",
    "./app.json": "./app.json",
    "./base.json": "./base.json",
    "./library.build.json": "./library.build.json",
    "./library.json": "./library.json",
    "./package.json": "./package.json"
  }
}
