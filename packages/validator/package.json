  },
  "devDependencies": {
    "@nest-boot/eslint-config": "workspace:^",
    "@nest-boot/eslint-plugin": "workspace:^",
    "@nest-boot/i18n": "workspace:^",
    "@nest-boot/tsconfig": "workspace:^",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@swc/core": "^1.16.1",
    "@types/node": "^26.0.0",
    "@types/validator": "^13.15.3",
    "@vitest/coverage-v8": "^4.1.11",
