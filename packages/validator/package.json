    "@nest-boot/i18n": "workspace:^",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
