{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".nvmrc", ".pnpmfile.cjs", "tsconfig*.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "@nest-boot/docs#build": {
      "outputs": [".next/**", "!.next/cache/**", ".source/**", "*.tsbuildinfo"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "clean": { "cache": false },
    "lint": { "dependsOn": ["^build"], "cache": false },
    "lint:fix": { "dependsOn": ["^build"], "cache": false },
    "test": { "dependsOn": ["build"], "cache": false },
    "test:cov": { "dependsOn": ["build"], "cache": false },
    "test:e2e": { "dependsOn": ["build"], "cache": false },
    "typecheck": { "dependsOn": ["^build"], "cache": false }
  }
}
