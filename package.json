{
  "private": true,
  "name": "@nest-boot/workspace",
  "repository": {
    "type": "git",
    "url": "https://github.com/nest-boot/nest-boot.git"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "commit:check": "lint-staged && pnpm build:packages",
    "commitlint": "commitlint",
    "cz": "cz",
    "prepare": "husky install",
    "build": "nx run-many -t build",
    "build:docs": "nx run @nest-boot/docs:build",
    "build:packages": "nx run-many -t build --projects='packages/*'",
    "build:examples": "nx run-many -t build --projects='examples/*'",
    "clean": "nx reset && nx run-many -t clean && rm -rf node_modules",
    "dev": "nx run-many -t dev --exclude=@nest-boot/docs --parallel=100 --skip-nx-cache",
    "dev:docs": "nx run @nest-boot/docs:dev",
    "test": "pnpm -r --filter './packages/**' --if-present test",
    "test:cov": "pnpm -r --filter './packages/**' --if-present test:cov",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint:fix",
    "release:dry-run": "nx release --dry-run --skip-publish",
    "test:e2e": "pnpm -r --filter './packages/**' --if-present test:e2e",
    "test:consumer": "node .github/scripts/verify-consumer.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@nest-boot/tsconfig": "workspace:^",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/graphql": "^14.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/testing": "^12.0.1",
    "@nx/js": "^22.7.5",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.3",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "nx": "^22.7.5",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "*.{md,json}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "type": "module"
}
