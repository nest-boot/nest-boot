{
  "private": true,
  "name": "@nest-boot/workspace",
  "repository": {
    "type": "git",
    "url": "https://github.com/nest-boot/nest-boot.git"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "commit:check": "lint-staged && pnpm build:packages",
    "commitlint": "commitlint",
    "cz": "cz",
    "prepare": "husky install",
    "build": "turbo run build",
    "build:docs": "turbo run build --filter=@nest-boot/docs",
    "build:packages": "turbo run build --filter='./packages/*'",
    "build:examples": "turbo run build --filter='./examples/*'",
    "clean": "turbo run clean && rm -rf .turbo node_modules",
    "dev": "turbo run dev --filter='!@nest-boot/docs' --concurrency=100 --env-mode=loose",
    "dev:docs": "turbo run dev --filter=@nest-boot/docs --env-mode=loose",
    "test": "pnpm -r --filter './packages/**' --if-present test",
    "test:cov": "pnpm -r --filter './packages/**' --if-present test:cov",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test:e2e": "pnpm -r --filter './packages/**' --if-present test:e2e",
    "test:consumer": "node .github/scripts/verify-consumer.mjs",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:version": "changeset version && pnpm install --lockfile-only",
    "test:release": "node --test .github/scripts/release-*.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@nest-boot/tsconfig": "workspace:^",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.3",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "*.{md,json}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "type": "module"
}
